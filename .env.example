# ==============================================================================
# Data Rewind — Environment Configuration Template
# All settings have safe local-first defaults. No values required for standard local run.
# ==============================================================================

# Application profile: "local" (default) or "hosted_demo"
DATA_REWIND_PROFILE=local

# Custom workspace storage directory (defaults to ~/.data_rewind)
# DATA_REWIND_DATA_DIR=/tmp/data_rewind

# Allowed CORS origins (comma-separated, for hosted deployments)
# Loopback origins (localhost:5173, etc.) are always permitted.
# DATA_REWIND_CORS_ORIGINS=https://data-rewind-ui.onrender.com

# Port for Uvicorn server (automatically injected by cloud providers, default 8000)
PORT=8000
